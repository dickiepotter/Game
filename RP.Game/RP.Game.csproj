<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 rather than net8.0 because the engine depends on RP.Sound, which targets net9.0.
         RP.Math stays multi-targeted at net8.0;netstandard2.0 — it is the published package and
         wants the broadest reach — and a net9.0 consumer references it happily. -->
    <TargetFramework>net9.0</TargetFramework>

    <!-- Mirror RP.Math's convention exactly so the two libraries read as siblings:
         a single root namespace equal to the assembly name, with area sub-namespaces beneath it
         (RP.Game.Core, RP.Game.Rendering, RP.Game.Physics, ...). -->
    <AssemblyName>RP.Game</AssemblyName>
    <RootNamespace>RP.Game</RootNamespace>

    <!-- This codebase is a teaching artefact (build brief S4.5): public APIs carry tutorial-grade
         XML docs, so emit the documentation file and let the missing-comment warnings guide us. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Silence "missing XML comment" (CS1591) / "missing param tag" (CS1573) while the surface is
         still being filled in, so genuine warnings stay visible. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Deliberately absent: AllowUnsafeBlocks. Nothing in the engine proper needs a pointer, and
         leaving the switch off is what keeps it that way. Pointers live in RP.Game.Silk, where
         Vulkan's C API forces them. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Dependency direction is strictly upward: Game depends on Math and Sound, never the reverse.
         Both are checked out as siblings of this repository (or as siblings under a consumer's
         extern/ directory, which is the same shape). -->
    <ProjectReference Include="..\..\Math\RP.Math\RP.Math.csproj" />
    <ProjectReference Include="..\..\Sound\RP.Sound\RP.Sound.csproj" />
  </ItemGroup>

</Project>
